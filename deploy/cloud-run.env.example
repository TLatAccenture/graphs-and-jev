# Copy to a private path, edit if needed, then pass it to deploy/deploy.sh.
# Identifiers and deployment settings only; never put credentials here.
PROJECT_ID=ninth-airship-386815
REGION=australia-southeast1
SERVICE=graphs-and-jev
ARTIFACT_REPOSITORY=graphs-and-jev
IMAGE=app
SOURCE_BUCKET=ninth-airship-386815-graphs-and-jev-build-source
LOG_BUCKET=956922431929-australia-southeast1-cloudbuild-logs
BUILD_SERVICE_ACCOUNT=graphs-and-jev-builder@${PROJECT_ID}.iam.gserviceaccount.com
RUNTIME_SERVICE_ACCOUNT=graphs-and-jev-runner@${PROJECT_ID}.iam.gserviceaccount.com
EXPECTED_ACCOUNT=anthony.lui@archegon.com
DEPLOY_OUTPUT=${TMPDIR:-/tmp}/graphs-and-jev-deployment-result.json

# App settings passed to the Cloud Run revision (rendered by the service as /config.js).
# Only these keys are passed; the revision gets exactly the ones set here, and unset or
# empty keys use the Rust defaults shown. Brand text and public settings only.
#BRAND_ORG="Accenture"
#BRAND_NAME="Migration Acceleration with Google Cloud"
#BRAND_TAGLINE="Stack migration and modernisation"
#BRAND_KIND="Thought piece"
#BRAND_DISCLAIMER="..."
#API_MODE=live
#API_BASE_URL=
#API_TIMEOUT_MS=15000
#API_ROUTE_HEALTH=/api/health
#API_ROUTE_CATALOGUE=/api/catalogue
#API_ROUTE_PIPELINE=/api/pipeline
#API_MODE_CATALOGUE=live
#API_MODE_LINEAGE=fixtures

# Event build: for a live presentation, run the catalogue demo in the browser so the audience
# cannot use up the shared API rate limit, and keep one instance warm to avoid a cold start.
# Remove both and deploy again afterwards to restore the live API and scaling to zero.
#API_MODE_CATALOGUE=fixtures
#MIN_INSTANCES=1

# Presenter build with Gemini: a separate, private service where Gemini on Vertex AI reads typed
# Environmental Agency requests and the catalogue rules still decide. See
# docs/deployment/presenter-gemini.md. deploy.sh refuses these on a public service, and
# promote.sh never makes such a revision public. Cloud Run calls Vertex AI as the runtime
# service account; never put a key file or token here.
#SERVICE=graphs-and-jev-presenter
#RUNTIME_SERVICE_ACCOUNT=graphs-and-jev-presenter@${PROJECT_ID}.iam.gserviceaccount.com
#CATALOGUE_INTERPRETER=gemini
#GEMINI_MODEL=gemini-3.8-flash
#GEMINI_LOCATION=global
#GEMINI_TIMEOUT_MS=8000
#GEMINI_THINKING_LEVEL=low
#GOOGLE_CLOUD_PROJECT=ninth-airship-386815
#MIN_INSTANCES=1

# Private Archegon presenter with Gemini interpretation and hosted Jev decisions.
# Use a dedicated runtime identity. The API key is never an app env value: deployment resolves
# this resource as a Cloud Run secretKeyRef. Prefer an explicit version for immutable releases.
#SERVICE=graphs-and-jev-presenter
#RUNTIME_SERVICE_ACCOUNT=graphs-and-jev-presenter@${PROJECT_ID}.iam.gserviceaccount.com
#CATALOGUE_INTERPRETER=gemini
#GEMINI_MODEL=gemini-3.8-flash
#DECISION_BACKEND=jev
#SERVICE_AUTH_MODE=cloud-run-iam
#JEV_MODEL=jev-1.2.3
#JEV_TIMEOUT_MS=8000
#JEV_PRICE_PER_MTOK=0
#JEV_MAX_CONCURRENCY=4
#JEV_PIPELINE_MAX_CALLS=20
#JEV_PIPELINE_TIMEOUT_MS=20000
#TYPESAFE_SECRET_RESOURCE=projects/ninth-airship-386815/secrets/typesafe-api-key/versions/1
#TYPESAFE_EGRESS_ACKNOWLEDGED=yes
# Never set TYPESAFE_API_KEY here. Bind the secret only while the consuming Jev code is present.
